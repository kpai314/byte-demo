# Relational Database Connection (PostgreSQL for production, SQLite for local)
DATABASE_URL=postgresql://byte_user:secure_password@localhost:5432/byte_campus_db
# DATABASE_URL=sqlite:///./byte_campus.db

# Campus Context
CAMPUS_CODE=DJSCE
CAMPUS_NAME="Dwarkadas J. Sanghvi College of Engineering"

